+// A texture the application owns (RGBA, straight alpha), bound as `t_y`.
+@fragment
+fn fs_surface_rgba(input: SurfaceVarying) -> @location(0) vec4<f32> {
+    if (any(input.clip_distances < vec4<f32>(0.0))) {
+        return vec4<f32>(0.0);
+    }
+    let color = textureSampleLevel(t_y, s_surface, input.texture_position, 0.0);
+    return blend_color(color, 1.0);
+}
