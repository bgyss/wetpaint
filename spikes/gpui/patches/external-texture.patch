+
+/// A GPU texture the application owns and renders itself, drawn by the window's renderer
+/// without a copy: a view of a texture on the device from [`crate::Window::external_gpu`].
+///
+/// It is opaque to gpui. The wgpu renderer takes a `wgpu::TextureView` of an RGBA texture
+/// with straight alpha, sampled as it is stored (as images are).
+///
+/// Not `Send`: in the browser wgpu's handles belong to the thread that made them, and a
+/// scene is built and drawn on the window's thread.
+#[derive(Clone)]
+pub struct ExternalTexture(pub std::rc::Rc<dyn Any>);
+
+impl ExternalTexture {
+    /// Wrap a renderer-specific texture view.
+    pub fn new(view: impl Any) -> Self {
+        Self(std::rc::Rc::new(view))
+    }
+}
+
+impl Debug for ExternalTexture {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("ExternalTexture")
+    }
 }
 
